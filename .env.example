# Supabase project settings → API. Both values are publishable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Loura system identity the server-side worker signs in as (see supabase/seed_test_identities.sql).
# Server-only: never prefixed with NEXT_PUBLIC_.
LOURA_SYSTEM_EMAIL=system@loura.test
LOURA_SYSTEM_PASSWORD=

# Optional. With a key, agents call Claude Opus 5. Without one, a labelled simulated path runs.
ANTHROPIC_API_KEY=
